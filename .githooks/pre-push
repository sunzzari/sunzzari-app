#!/bin/sh
#
# Refuses a push to the default branch that changes the app without adding a
# changelog entry.
#
# Turn it on once per clone:   git config core.hooksPath .githooks
# Bypass it when you must:     git push --no-verify
#
# Why this exists: CHANGELOG.md was started on 2026-05-13 and then went
# unwritten for 41 commits and four months, because nothing checked. A rule
# that depends on remembering is a rule that stops working.

CHANGELOG="CHANGELOG.md"
ZERO="0000000000000000000000000000000000000000"

# Paths that count as "you changed the app"
watched='^(Sunzzari/.*\.swift|Sunzzari\.xcodeproj/)'

while read -r _local_ref local_sha remote_ref remote_sha; do
	# Deleting a branch - nothing to check
	[ "$local_sha" = "$ZERO" ] && continue

	# Only guard the default branch
	case "$remote_ref" in
		refs/heads/main|refs/heads/master) ;;
		*) continue ;;
	esac

	if [ "$remote_sha" = "$ZERO" ]; then
		# Branch is new on the remote; check the last commit only
		range="$local_sha~1..$local_sha"
	else
		range="$remote_sha..$local_sha"
	fi

	changed=$(git diff --name-only "$range" 2>/dev/null) || continue
	[ -z "$changed" ] && continue

	echo "$changed" | grep -Eq "$watched" || continue
	echo "$changed" | grep -qx "$CHANGELOG" && continue

	cat >&2 <<EOF

  Push refused: you changed the app but not the changelog.

  These commits touch Swift sources or the Xcode project but leave
  $CHANGELOG alone.

  Add an entry at the TOP of $CHANGELOG:

    ## $(date +%Y-%m-%d)

    - **What changed** - why it matters, in plain language.

  Then:  git add $CHANGELOG && git commit --amend --no-edit && git push

  See CONTRIBUTING.md. To skip deliberately: git push --no-verify

EOF
	exit 1
done

exit 0
