import Foundation

/// SETUP: Copy this file to Secrets.swift and fill in the real values.
/// Secrets.swift is gitignored — never commit it.
///
/// This template must stay in sync with `ci_scripts/ci_post_clone.sh`, which
/// generates the same type for Xcode Cloud. A member present in one but not the
/// other builds locally and fails in the cloud (or vice versa).
enum Secrets {
    enum Notion {
        static let token = "REPLACE_WITH_NOTION_TOKEN"
    }
    enum Push {
        static let secret = "REPLACE_WITH_PUSH_SECRET"
    }
    /// Powers the "Open Now" restaurant filter. Safe to leave empty —
    /// PlacesService disables the feature when the key is blank.
    enum GooglePlaces {
        static let apiKey = "REPLACE_WITH_GOOGLE_PLACES_API_KEY"
    }
}
